{
  "name": "resa",
  "version": "0.1.0",
  "private": true,
  "description": "Résa — réservation des salles du campus",
  "main": "src/server.js",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "doctor": "node scripts/doctor.mjs",
    "lint": "eslint .",
    "format": "prettier --write ."
    "prepare": "husky"
  },
  "dependencies": {
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "express": "4.17.1",
    "lodash": "4.17.15",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1"
  },
  "lint-staged": {
    "*.{js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html,yml,yaml}": "prettier --write"
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7"
  }
}
